@code {
    [Parameter] public required string Source { get; set; }

    private string CssClass => Source switch
    {
        "arXiv"            => "badge badge-arxiv",
        "Papers with Code" => "badge badge-pwc",
        "Hugging Face"     => "badge badge-hf",
        "Semantic Scholar" => "badge badge-ss",
        _                  => "badge"
    };
}

<span class="@CssClass">@Source</span>

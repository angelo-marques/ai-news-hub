@page "/"
@inject ArticleService ArticleService
@inject IJSRuntime JS

<PageTitle>Hub IA Brasil — Tecnologia & Inteligência Artificial</PageTitle>

<!-- ══ TOP BAR ══ -->
<div class="topbar">
    <div class="topbar-inner">
        <span class="topbar-date">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</span>
        <div class="topbar-links">
            <a href="https://arxiv.org/list/cs.AI/recent" target="_blank">arXiv</a>
            <span class="topbar-sep">|</span>
            <a href="https://paperswithcode.com" target="_blank">Papers with Code</a>
        </div>
    </div>
</div>

<!-- ══ HEADER ══ -->
<header class="site-header">
    <div class="header-inner">
        <a href="/" class="logo" style="display:flex;align-items:center;">
            <img src="img/logo.png" alt="Logo Hub IA" style="width:auto;height:38px;border-radius:8px;box-shadow:0 0 10px rgba(0,200,255,0.2);flex-shrink:0;" />
            <div>
                <div class="logo-name">Hub IA Brasil</div>
                <div class="logo-tagline">Tecnologia & Inteligência Artificial</div>
            </div>
        </a>

        <nav class="main-nav">
            <button class="nav-item @(activeFilter == "all"   ? "nav-item--active" : "")"
                    @onclick='() => SetFilter("all")'>Início</button>
            <button class="nav-item @(activeFilter == "arxiv" ? "nav-item--active" : "")"
                    @onclick='() => SetFilter("arxiv")'>arXiv</button>
            <button class="nav-item @(activeFilter == "pwc"   ? "nav-item--active" : "")"
                    @onclick='() => SetFilter("pwc")'>Papers w/ Code</button>
            <button class="nav-item @(activeFilter == "hf"    ? "nav-item--active" : "")"
                    @onclick='() => SetFilter("hf")'>Hugging Face</button>
            <button class="nav-item @(activeFilter == "ss"    ? "nav-item--active" : "")"
                    @onclick='() => SetFilter("ss")'>Semantic Scholar</button>
        </nav>

        <div class="header-actions">
            <div class="search-wrap">
                <span class="search-icon">⌕</span>
                <input class="search-input" type="search" placeholder="Buscar notícias..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>
            <button class="theme-btn" @onclick="ToggleTheme" title="Alternar tema">
                @(isDark ? "☀" : "🌙")
            </button>
            <button class="menu-btn" @onclick="() => mobileMenuOpen = !mobileMenuOpen">☰</button>
        </div>
    </div>

    @if (mobileMenuOpen)
    {
        <div class="mobile-nav">
            <button @onclick='() => { SetFilter("all");   mobileMenuOpen = false; }'>Início</button>
            <button @onclick='() => { SetFilter("arxiv"); mobileMenuOpen = false; }'>arXiv</button>
            <button @onclick='() => { SetFilter("pwc");   mobileMenuOpen = false; }'>Papers with Code</button>
            <button @onclick='() => { SetFilter("hf");    mobileMenuOpen = false; }'>Hugging Face</button>
            <button @onclick='() => { SetFilter("ss");    mobileMenuOpen = false; }'>Semantic Scholar</button>
        </div>
    }
</header>

<!-- ══ TICKER ══ -->
@if (allArticles.Any())
{
    var tickerItems = allArticles.Take(6).ToList();
    <div class="ticker-wrap">
        <span class="ticker-label">DESTAQUE</span>
        <div class="ticker-track">
            @* Duplicate for seamless loop *@
            @foreach (var a in tickerItems)
            {
                <span class="ticker-item" @onclick="() => OpenArticle(a)">@a.TitlePt</span>
                <span class="ticker-sep">◆</span>
            }
            @foreach (var a in tickerItems)
            {
                <span class="ticker-item" @onclick="() => OpenArticle(a)">@a.TitlePt</span>
                <span class="ticker-sep">◆</span>
            }
        </div>
    </div>
}

<!-- ══ MAIN ══ -->
<main class="main">

    @if (isLoading)
    {
        <div class="state-center">
            <div class="splash-loader" style="justify-content:center;">
                <span></span><span></span><span></span>
            </div>
            <p class="state-text" style="margin-top:16px;">Carregando notícias...</p>
        </div>
    }
    else if (errorMsg is not null)
    {
        <div class="state-center">
            <p class="state-error">⚠ @errorMsg</p>
        </div>
    }
    else if (!filtered.Any())
    {
        <div class="state-center">
            <p class="state-text">Nenhum artigo encontrado.</p>
            <button class="btn-clear" @onclick="ClearFilters">Limpar filtros</button>
        </div>
    }
    else
    {
        var featured   = filtered.First();
        var secondary  = filtered.Skip(1).Take(2).ToList();
        var gridItems  = filtered.Skip(3).ToList();

        <!-- ══ HERO ══ -->
        <section class="hero">
            <div class="hero-inner">

                <!-- Featured -->
                <article class="hero-featured" @onclick="() => OpenArticle(featured)">
                    <div class="hero-img-wrap">
                        <img src="@GetImageUrl(featured)" alt="@featured.TitlePt"
                             onerror="this.onerror=null; this.src='@GetFallbackImageUrl(featured)';"
                             class="hero-img" loading="lazy" />
                        <div class="hero-img-overlay"></div>
                        <div class="hero-badge-wrap">
                            <SourceBadge Source="@featured.Source" />
                        </div>
                    </div>
                    <div class="hero-content">
                        <div class="hero-eyebrow">
                            @if (IsNew(featured))
                            {
                                <span class="badge badge-new">NOVO</span>
                            }
                            <span class="meta-date">@DisplayDate(featured).ToString("dd MMM yyyy")</span>
                            <span class="meta-sep">·</span>
                            <span class="meta-authors">@FormatAuthors(featured.Authors)</span>
                            @if (!string.IsNullOrEmpty(featured.TranslatorProvider))
                            {
                                <span class="meta-sep">·</span>
                                <span class="badge" style="font-size:10px; background:#1a1a2e; color:#4facfe;">✨ IA: @featured.TranslatorProvider</span>
                            }
                        </div>
                        <h2 class="hero-title">@featured.TitlePt</h2>
                        <div class="hero-tags">
                            @foreach (var tag in featured.Tags.Take(4))
                            {
                                <span class="tag" @onclick:stopPropagation
                                      @onclick="() => SetTag(tag)">#@tag</span>
                            }
                        </div>
                        <span class="hero-read-more">Ler análise completa →</span>
                    </div>
                </article>

                <!-- Secondary -->
                <div class="hero-secondary">
                    @foreach (var art in secondary)
                    {
                        <article class="hero-side" @onclick="() => OpenArticle(art)">
                            <div class="side-img-wrap">
                                <img src="@GetImageUrl(art)" alt="@art.TitlePt"
                                     onerror="this.onerror=null; this.src='@GetFallbackImageUrl(art)';"
                                     class="side-img" loading="lazy" />
                            </div>
                            <div class="side-content">
                                <div class="side-eyebrow">
                                    <SourceBadge Source="@art.Source" />
                                    @if (IsNew(art))
                                    {
                                        <span class="badge badge-new">NOVO</span>
                                    }
                                </div>
                                <h3 class="side-title">@art.TitlePt</h3>
                                <div class="side-meta">
                                    <span>@DisplayDate(art).ToString("dd/MM/yyyy")</span> · <span>@FormatAuthors(art.Authors)</span>
                                    @if (!string.IsNullOrEmpty(art.TranslatorProvider))
                                    {
                                        <span class="badge" style="font-size:10px; background:#1a1a2e; color:#4facfe; margin-left:4px;">✨ @art.TranslatorProvider</span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>

        <!-- ══ FILTER BAR ══ -->
        <div class="filter-bar">
            <div class="filter-row">
                <div class="filter-pills">
                    <button class="pill @(activeFilter == "all"   ? "pill--active" : "")"
                            @onclick='() => SetFilter("all")'>
                        Todos <span class="pill-count">@allArticles.Count</span>
                    </button>
                    <button class="pill @(activeFilter == "arxiv" ? "pill--active" : "")"
                            @onclick='() => SetFilter("arxiv")'>
                        arXiv <span class="pill-count">@allArticles.Count(a => a.Source == "arXiv")</span>
                    </button>
                    <button class="pill @(activeFilter == "pwc"   ? "pill--active" : "")"
                            @onclick='() => SetFilter("pwc")'>
                        Papers w/ Code <span class="pill-count">@allArticles.Count(a => a.Source == "Papers with Code")</span>
                    </button>
                    <button class="pill @(activeFilter == "hf"    ? "pill--active" : "")"
                            @onclick='() => SetFilter("hf")'>
                        Hugging Face <span class="pill-count">@allArticles.Count(a => a.Source == "Hugging Face")</span>
                    </button>
                    <button class="pill @(activeFilter == "ss"    ? "pill--active" : "")"
                            @onclick='() => SetFilter("ss")'>
                        Semantic Scholar <span class="pill-count">@allArticles.Count(a => a.Source == "Semantic Scholar")</span>
                    </button>
                    @if (!string.IsNullOrEmpty(activeTag))
                    {
                        <button class="pill pill--tag pill--active" @onclick="() => activeTag = string.Empty">
                            #@activeTag <span class="pill-remove">✕</span>
                        </button>
                    }
                </div>
                <div class="filter-search-wrap">
                    <span class="filter-search-icon">⌕</span>
                    <input class="filter-search" type="search" placeholder="Busca inteligente..."
                           @bind="searchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div class="filter-row filter-row--time">
                <span class="filter-label">Período:</span>
                <div class="time-pills">
                    <button class="time-pill @(timeFilter == "today" ? "time-pill--active" : "")"
                            @onclick='() => SetTime("today")'>Hoje</button>
                    <button class="time-pill @(timeFilter == "week"  ? "time-pill--active" : "")"
                            @onclick='() => SetTime("week")'>Esta semana</button>
                    <button class="time-pill @(timeFilter == "month" ? "time-pill--active" : "")"
                            @onclick='() => SetTime("month")'>Este mês</button>
                    <button class="time-pill @(timeFilter == "all"   ? "time-pill--active" : "")"
                            @onclick='() => SetTime("all")'>Todos</button>
                </div>
                <span class="filter-result-count">
                    @filtered.Count() resultado@(filtered.Count() != 1 ? "s" : "")
                </span>
            </div>
        </div>

        <!-- ══ GRID ══ -->
        @if (gridItems.Any())
        {
            <h2 class="section-heading">Mais Notícias</h2>
            <div class="grid">
                @foreach (var art in gridItems)
                {
                    <article class="card" @onclick="() => OpenArticle(art)">
                        <div class="card-img-wrap">
                            <img src="@GetImageUrl(art)" alt="@art.TitlePt"
                                 onerror="this.onerror=null; this.src='@GetFallbackImageUrl(art)';"
                                 class="card-img" loading="lazy" />
                        </div>
                        <div class="card-body">
                            <div class="card-eyebrow">
                                <SourceBadge Source="@art.Source" />
                                @if (IsNew(art))
                                {
                                    <span class="badge badge-new">NOVO</span>
                                }
                            </div>
                            <h3 class="card-title">@art.TitlePt</h3>
                            <div class="card-meta">
                                <span>@DisplayDate(art).ToString("dd/MM/yyyy")</span>
                                <span class="meta-sep">·</span>
                                <span>@FormatAuthors(art.Authors)</span>
                                @if (!string.IsNullOrEmpty(art.TranslatorProvider))
                                {
                                    <span class="meta-sep">·</span>
                                    <span class="badge" style="font-size:10px; background:#1a1a2e; color:#4facfe;">✨ IA: @art.TranslatorProvider</span>
                                }
                            </div>
                            <div class="card-tags">
                                @foreach (var tag in art.Tags.Take(3))
                                {
                                    <span class="tag" @onclick:stopPropagation
                                          @onclick="() => SetTag(tag)">#@tag</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }
</main>

<!-- ══ ARTICLE MODAL ══ -->
@if (selectedArticle is not null)
{
    <div class="modal-overlay" @onclick="CloseArticle">
        <div class="modal" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseArticle">✕</button>

            <div class="modal-img-wrap">
                <img src="@GetImageUrl(selectedArticle)" alt="@selectedArticle.TitlePt"
                     onerror="this.onerror=null; this.src='@GetFallbackImageUrl(selectedArticle)';"
                     class="modal-img" />
            </div>

            <div class="modal-body">
                <div class="modal-eyebrow">
                    <SourceBadge Source="@selectedArticle.Source" />
                    @if (IsNew(selectedArticle))
                    {
                        <span class="badge badge-new">NOVO</span>
                    }
                </div>

                <h1 class="modal-title">@selectedArticle.TitlePt</h1>

                <div class="modal-meta">
                    <span class="meta-date">
                        @DisplayDate(selectedArticle).ToString("dd 'de' MMMM 'de' yyyy")
                    </span>
                    <span class="modal-meta-sep">·</span>
                    <span>@FormatAuthors(selectedArticle.Authors)</span>
                    @if (!string.IsNullOrEmpty(selectedArticle.TranslatorProvider))
                    {
                        <span class="modal-meta-sep">·</span>
                        <span class="badge" style="font-size:10px; background:#1a1a2e; color:#4facfe;">✨ Traduzido por IA: @selectedArticle.TranslatorProvider</span>
                    }
                </div>

                <div class="modal-tags">
                    @foreach (var tag in selectedArticle.Tags)
                    {
                        <span class="tag" @onclick="() => { SetTag(tag); CloseArticle(); }">#@tag</span>
                    }
                </div>

                <div class="modal-content">
                    @((MarkupString)selectedArticle.NewsHtml)
                </div>

                <div class="modal-author-section">
                    <div class="author-card">
                        <span class="author-label">Redação</span>
                        <span class="author-name">Angelo Marques de Oliveira Silva</span>
                        <span class="author-role">Hub IA Brasil — Tecnologia & Inteligência Artificial</span>
                    </div>
                    <div class="modal-actions">
                        <a href="@selectedArticle.PaperUrl" target="_blank" class="btn-action btn-paper">
                            ↗ Artigo Original
                        </a>
                        @if (!string.IsNullOrEmpty(selectedArticle.CodeUrl))
                        {
                            <a href="@selectedArticle.CodeUrl" target="_blank" class="btn-action btn-code">
                                { } Código
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ══ TECH INFO SECTION ══ -->
<section class="tech-section">
    <div class="tech-inner">
        <div class="tech-card">
            <span class="tech-icon">🧠</span>
            <div>
                <div class="tech-title">Ecossistema Multi-IA</div>
                <div class="tech-desc">A plataforma conta com um cluster corporativo de 5 IAs (Groq, OpenRouter, DeepSeek, Together AI e OpenAI) para programação de buscas e resiliência de traduções.</div>
            </div>
        </div>
        <div class="tech-card">
            <span class="tech-icon">⚡</span>
            <div>
                <div class="tech-title">Blazor WebAssembly</div>
                <div class="tech-desc">Interface executada diretamente no navegador via WebAssembly — sem servidor, carregamento instantâneo e disponível offline.</div>
            </div>
        </div>
        <div class="tech-card">
            <span class="tech-icon">🔍</span>
            <div>
                <div class="tech-title">Busca Inteligente</div>
                <div class="tech-desc">Pesquise por título em português ou inglês, palavras-chave e tags simultaneamente em todas as fontes com filtros por período e origem.</div>
            </div>
        </div>
        <div class="tech-card">
            <span class="tech-icon">📡</span>
            <div>
                <div class="tech-title">4 Fontes Científicas</div>
                <div class="tech-desc">Cobertura de arXiv, Hugging Face Daily Papers, Papers with Code e Semantic Scholar — os principais repositórios internacionais de pesquisa em IA.</div>
            </div>
        </div>
        <div class="tech-card">
            <span class="tech-icon">🔄</span>
            <div>
                <div class="tech-title">Atualização Diária</div>
                <div class="tech-desc">Conteúdo renovado três vezes ao dia com as publicações mais recentes e relevantes do ecossistema global de inteligência artificial.</div>
            </div>
        </div>
    </div>
</section>

<!-- ══ PIPELINE SECTION ══ -->
<section class="pipeline-section">
    <div class="pipeline-inner">

        <div class="pipeline-header">
            <span class="pipeline-label">Como funciona</span>
            <h2 class="pipeline-title">Do Abstract Científico à Notícia em PT-BR</h2>
            <p class="pipeline-subtitle">
                Cada publicação passa por um pipeline automatizado de inteligência artificial que transforma
                um abstract técnico em inglês em uma notícia jornalística completa para o público brasileiro —
                citando sempre as fontes originais.
            </p>
        </div>

        <!-- Fluxo do pipeline -->
        <div class="pipeline-flow">
            <div class="pipeline-step">
                <div class="pipeline-step-icon">📡</div>
                <div class="pipeline-step-num">01</div>
                <div class="pipeline-step-title">Coleta</div>
                <div class="pipeline-step-desc">Papers recém-publicados são buscados automaticamente em arXiv, Hugging Face, Papers with Code e Semantic Scholar 3× ao dia.</div>
            </div>
            <div class="pipeline-arrow">→</div>
            <div class="pipeline-step">
                <div class="pipeline-step-icon">📄</div>
                <div class="pipeline-step-num">02</div>
                <div class="pipeline-step-title">Abstract</div>
                <div class="pipeline-step-desc">O abstract original em inglês é extraído junto com título, autores, instituições e metadados relevantes da publicação científica.</div>
            </div>
            <div class="pipeline-arrow">→</div>
            <div class="pipeline-step">
                <div class="pipeline-step-icon">🧠</div>
                <div class="pipeline-step-num">03</div>
                <div class="pipeline-step-title">IA Redige</div>
                <div class="pipeline-step-desc">Um cluster de até 9 IAs gera a notícia em PT-BR com estrutura jornalística completa, tags semânticas e tom adaptado ao público brasileiro.</div>
            </div>
            <div class="pipeline-arrow">→</div>
            <div class="pipeline-step">
                <div class="pipeline-step-icon">🚀</div>
                <div class="pipeline-step-num">04</div>
                <div class="pipeline-step-title">Publicação</div>
                <div class="pipeline-step-desc">O artigo é validado, salvo e publicado automaticamente via GitHub Actions — sempre com link para o paper original e citação dos autores.</div>
            </div>
        </div>

        <!-- Estrutura jornalística + Stack -->
        <div class="pipeline-details">

            <div class="pipeline-detail-card">
                <div class="pipeline-detail-title">📰 Estrutura Jornalística Gerada</div>
                <ul class="pipeline-list">
                    <li><strong>Lead</strong> — 1 parágrafo direto revelando a descoberta principal</li>
                    <li><strong>Contexto e Metodologia</strong> — problema abordado e como foi resolvido</li>
                    <li><strong>Resultados</strong> — números, benchmarks e métricas do paper</li>
                    <li><strong>Impacto e Aplicações</strong> — relevância para o ecossistema e mercado BR</li>
                    <li><strong>Perspectiva do Redator</strong> — análise crítica e conclusão</li>
                    <li><strong>Tags semânticas</strong> — 5 palavras-chave em PT-BR ou inglês</li>
                    <li><strong>Título impactante</strong> — até 110 caracteres, estilo jornalístico</li>
                    <li><strong>Fonte original</strong> — citação e link para o paper científico</li>
                </ul>
            </div>

            <div class="pipeline-detail-card">
                <div class="pipeline-detail-title">⚡ Tecnologias Utilizadas</div>
                <div class="pipeline-tech-group">
                    <div class="pipeline-tech-label">Provedores de IA (failover em cascata)</div>
                    <div class="pipeline-tech-badges">
                        <span class="ptbadge ptbadge-ai">Groq</span>
                        <span class="ptbadge ptbadge-ai">Cerebras</span>
                        <span class="ptbadge ptbadge-ai">Mistral</span>
                        <span class="ptbadge ptbadge-ai">OpenRouter</span>
                        <span class="ptbadge ptbadge-ai">DeepSeek</span>
                        <span class="ptbadge ptbadge-ai">TogetherAI</span>
                        <span class="ptbadge ptbadge-ai">Gemini</span>
                        <span class="ptbadge ptbadge-ai">OpenAI</span>
                    </div>
                </div>
                <div class="pipeline-tech-group">
                    <div class="pipeline-tech-label">Plataforma &amp; Infraestrutura</div>
                    <div class="pipeline-tech-badges">
                        <span class="ptbadge ptbadge-plat">.NET 10</span>
                        <span class="ptbadge ptbadge-plat">Blazor WASM</span>
                        <span class="ptbadge ptbadge-plat">GitHub Actions</span>
                        <span class="ptbadge ptbadge-plat">GitHub Pages</span>
                    </div>
                </div>
                <div class="pipeline-tech-group">
                    <div class="pipeline-tech-label">Fontes Científicas</div>
                    <div class="pipeline-tech-badges">
                        <span class="ptbadge ptbadge-src">arXiv</span>
                        <span class="ptbadge ptbadge-src">Hugging Face</span>
                        <span class="ptbadge ptbadge-src">Papers with Code</span>
                        <span class="ptbadge ptbadge-src">Semantic Scholar</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ══ FOOTER ══ -->
<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-col footer-col--brand">
            <div class="footer-brand-name" style="display:flex; align-items:center;">
                <img src="img/logo.png" style="width:auto;height:24px;border-radius:4px;margin-right:8px;flex-shrink:0;" /> Hub IA Brasil
            </div>
            <p class="footer-desc">
                Portal de cobertura jornalística sobre pesquisas e avanços em inteligência artificial. 
                <br/><strong>Alimentado por um pipeline de 5 inteligências artificiais autônomas.</strong><br />
                Redação: <strong>Angelo Marques de Oliveira Silva</strong>.
            </p>
            <div class="footer-tech-badge">
                <span>Powered by</span>
                <strong>Blazor WebAssembly</strong>
                <span>·</span>
                <strong>.NET 9</strong>
            </div>
        </div>
        <div class="footer-col">
            <div class="footer-heading">Fontes de Pesquisa</div>
            <div class="footer-links">
                <a href="https://arxiv.org/list/cs.AI/recent" target="_blank">
                    <span class="footer-link-badge badge-arxiv-sm">arXiv</span> cs.AI / cs.LG / cs.CL / cs.CV
                </a>
                <a href="https://huggingface.co/papers" target="_blank">
                    <span class="footer-link-badge badge-hf-sm">HF</span> Hugging Face Daily Papers
                </a>
                <a href="https://paperswithcode.com" target="_blank">
                    <span class="footer-link-badge badge-pwc-sm">PwC</span> Papers with Code
                </a>
                <a href="https://www.semanticscholar.org" target="_blank">
                    <span class="footer-link-badge badge-ss-sm">SS</span> Semantic Scholar
                </a>
            </div>
        </div>
        <div class="footer-col">
            <div class="footer-heading">Navegação</div>
            <div class="footer-links">
                <button class="footer-nav-btn" @onclick='() => { SetFilter("all"); SetTime("all"); }'>Todas as notícias</button>
                <button class="footer-nav-btn" @onclick='() => SetFilter("arxiv")'>arXiv</button>
                <button class="footer-nav-btn" @onclick='() => SetFilter("hf")'>Hugging Face</button>

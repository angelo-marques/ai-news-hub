<button class="scroll-top" @onclick="ScrollToTop" title="Voltar ao topo">↑</button>

@code {
    private List<Article> allArticles = [];
    private string  activeFilter   = "all";
    private string  timeFilter     = "all";
    private string  activeTag      = string.Empty;
    private string  searchQuery    = string.Empty;
    private bool    isLoading      = true;
    private bool    isDark         = true;
    private bool    mobileMenuOpen = false;
    private string? errorMsg;
    private Article? selectedArticle;
    private bool _themeInit = false;

    private IEnumerable<Article> filtered => allArticles
        .Where(a => activeFilter switch
        {
            "arxiv" => a.Source == "arXiv",
            "pwc"   => a.Source == "Papers with Code",
            "hf"    => a.Source == "Hugging Face",
            "ss"    => a.Source == "Semantic Scholar",
            _       => true
        })
        .Where(a => timeFilter switch
        {
            "today" => a.PublishedAt.Date >= DateTime.UtcNow.Date.AddDays(-1),
            "week"  => a.PublishedAt     >= DateTime.UtcNow.AddDays(-7),
            "month" => a.PublishedAt     >= DateTime.UtcNow.AddDays(-30),
            _       => true
        })
        .Where(a => string.IsNullOrEmpty(activeTag)   || a.Tags.Contains(activeTag, StringComparer.OrdinalIgnoreCase))
        .Where(a => string.IsNullOrEmpty(searchQuery) ||
                    a.TitlePt.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    a.Title.Contains(searchQuery,   StringComparison.OrdinalIgnoreCase) ||
                    a.Tags.Any(t => t.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allArticles = await ArticleService.LoadArticlesAsync();
        }
        catch (Exception ex)
        {
            errorMsg = $"Erro ao carregar artigos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_themeInit)
        {
            _themeInit = true;
            var theme = await JS.InvokeAsync<string>("themeManager.init");
            isDark = theme != "light";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        isDark = !isDark;
        await JS.InvokeVoidAsync("themeManager.set", isDark ? "dark" : "light");
    }

    private async Task ScrollToTop() =>
        await JS.InvokeVoidAsync("scrollToTop");

    private void OpenArticle(Article a)
    {
        selectedArticle = a;
        _ = JS.InvokeVoidAsync("lockBodyScroll", true);
    }

    private void CloseArticle()
    {
        selectedArticle = null;
        _ = JS.InvokeVoidAsync("lockBodyScroll", false);
    }

    private void SetFilter(string f) { activeFilter = f; }
    private void SetTime(string t)   { timeFilter = t; }
    private void SetTag(string tag)  { activeTag = tag; }

    private void ClearFilters()
    {
        activeFilter = "all";
        timeFilter   = "all";
        activeTag    = string.Empty;
        searchQuery  = string.Empty;
    }

    private static bool IsNew(Article a) =>
        (DateTime.UtcNow - a.FetchedAt).TotalHours < 24;

    private static string FormatAuthors(string[] authors) =>
        authors.Length == 0 ? "" :
        authors.Length <= 2 ? string.Join(", ", authors) :
        $"{authors[0]} et al.";

    /// Returns the display date for an article, clamped to today if it is in the future.
    private static DateTime DisplayDate(Article art)
    {
        var now = DateTime.UtcNow;
        return art.PublishedAt > now ? now : art.PublishedAt;
    }

    /// Imagem do artigo via loremflickr (/any + "technology" garante foto real sempre).
    /// ar5iv foi removido pois retorna HTTP 200 com placeholder "NO IMAGE" — onerror não dispara.
    private static string GetImageUrl(Article art) => GetFlickrUrl(art);

    /// Fallback onerror: picsum é 100% confiável — sempre retorna uma foto.
    private static string GetFallbackImageUrl(Article art)
    {
        var seed = (uint)art.Id.GetHashCode() % 900 + 100;
        return $"https://picsum.photos/seed/{seed}/800/450";
    }

    /// loremflickr /any mode: retorna foto que bata com QUALQUER dos termos.
    /// "technology" garante match; primeira tag do artigo dá relevância ao conteúdo.
    private static string GetFlickrUrl(Article art)
    {
        var tag = (art.Tags.FirstOrDefault() ?? "research")
            .ToLowerInvariant()
            .Replace(" ", "+");
        var seed = (uint)art.Id.GetHashCode() % 9999 + 1;
        return $"https://loremflickr.com/800/450/technology,{tag}/any?lock={seed}";
    }
}
